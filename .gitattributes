# Line endings
* text=auto
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Export ignore — exclude these files from `git archive` ZIP downloads
.gitattributes export-ignore
.gitignore export-ignore
vitest.config.ts export-ignore
tsconfig.json export-ignore
tests/ export-ignore
pnpm-lock.yaml export-ignore
