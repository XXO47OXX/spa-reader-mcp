{
  "name": "spa-reader-mcp",
  "version": "1.0.3",
  "description": "MCP Server that renders JavaScript SPA pages and extracts LLM-ready Markdown content",
  "type": "module",
  "license": "MIT",
  "author": "XXO47OXX",
  "mcpName": "io.github.XXO47OXX/spa-reader-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XXO47OXX/spa-reader-mcp.git"
  },
  "homepage": "https://github.com/XXO47OXX/spa-reader-mcp#readme",
  "bugs": {
    "url": "https://github.com/XXO47OXX/spa-reader-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "spa",
    "web-scraping",
    "playwright",
    "readability",
    "markdown",
    "llm",
    "ai"
